[Unit]
Description=PJ-Portal availability check (one-shot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pjportal
Group=pjportal
WorkingDirectory=/opt/pjportal
EnvironmentFile=/etc/pjportal.env
ExecStart=/opt/pjportal/.venv/bin/python /opt/pjportal/pjportal.py
StandardOutput=journal
StandardError=journal

# Encrypted secrets — decrypted into $CREDENTIALS_DIRECTORY at start, tmpfs, gone at stop.
# Encrypt/rotate with: sudo systemd-creds encrypt --name=pjportal_pwd - /etc/pjportal/pjportal_pwd.cred
# To also encrypt Pushover/ntfy tokens, drop additional LoadCredentialEncrypted= lines here.
LoadCredentialEncrypted=pjportal_pwd:/etc/pjportal/pjportal_pwd.cred

# Sandboxing — network only, no filesystem writes outside state dir
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/pjportal
