# Required (non-secret)
pjportal_user=your.email@uni-example.de
ajax_uid=1234567

# Comma-separated lists — all combinations are checked each tick.
pj_tag=Chirurgie,Innere Medizin
hospital=Ulm Universitätsklinikum
term=first_term,second_term,third_term

# Notification via ntfy (https://ntfy.sh — free, no account needed)
ntfy_url_topic=https://ntfy.sh/your-private-topic

# Cookie persistence (keeps you logged in between ticks)
cookie_filepath=/var/lib/pjportal/cookie.txt

# NOTE: pjportal_pwd is NOT stored here.
# It is encrypted into /etc/pjportal/pjportal_pwd.cred during install.sh.
