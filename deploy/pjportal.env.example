# Required (non-secret)
pjportal_user=your.email@uni-example.de
ajax_uid=1234567

# Each of pj_tag, hospital, term accepts a comma-separated list.
# The bot checks every combination (Cartesian product) and skips silently
# if a combo isn't in your Merkliste. Whitespace around commas is trimmed.
# Do NOT wrap in quotes and do NOT include commas inside a name.
pj_tag=Allgemeinmedizin,Chirurgie
hospital=Ulm Universitätsklinikum
term=first_term,second_term,third_term

# NOTE: pjportal_pwd is NOT stored here.
# It is encrypted with systemd-creds into /etc/pjportal/pjportal_pwd.cred
# during `install.sh` and loaded into the service via LoadCredentialEncrypted=.

# State — cookie is persisted here across runs
cookie_filepath=/var/lib/pjportal/cookie.txt

# Optional: seed cookie value used only when cookie_filepath is empty
cookie_default_value=

# Optional notifications — configure at least one
pushover_user=
pushover_token=
ntfy_url_topic=
